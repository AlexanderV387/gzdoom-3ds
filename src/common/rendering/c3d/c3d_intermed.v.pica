; c3d_intermed.v.pica
; Intermediate shader (test 27, variant V3): engine uniforms (8 fvecs) but
; simple_tri body (7 instructions). No texcoord output, no extra dp4, no mul.
; Color comes from v2 (engine attribute layout).
;
; 2026 AlexanderV387 (Nintendo 3DS port). GPL v3 (see LICENSE).

.fvec mvp[4]
.fvec colorscale
.fvec colormul
.fvec texmat[2]

.constf ones(1.0, 1.0, 1.0, 1.0)

.out outpos position
.out outcol color

.alias inpos v0
.alias incol v2

.proc main
	mov r0.xyz, inpos
	mov r0.w,   ones

	dp4 outpos.x, mvp[0], r0
	dp4 outpos.y, mvp[1], r0
	dp4 outpos.z, mvp[2], r0
	dp4 outpos.w, mvp[3], r0

	mov outcol, incol

	end
.end
