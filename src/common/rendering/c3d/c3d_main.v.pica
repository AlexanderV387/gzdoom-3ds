; c3d_main.v.pica
; The citro3d backend's one vertex shader: transforms the position by the
; combined projection * view * model matrix (with the 3DS screen's 90 degree
; tilt folded in), passes the texture coordinates through and scales the
; vertex color (bytes from a buffer, or the render state's color as a fixed
; attribute). Everything per-pixel happens in the texture combiners.
;
; 2026 AlexanderV387 (Nintendo 3DS port). GPL v3 (see LICENSE).

.fvec mvp[4]
.fvec colorscale	; multiplies the color: 1/255 for bytes, 1 for floats
.fvec colormul		; the render state's light/vertex color for buffers with colors
.fvec texmat[2]		; texture matrix rows (s, t), identity when unused

.constf ones(1.0, 1.0, 1.0, 1.0)

.out outpos position
.out outtc0 texcoord0
.out outcol color

.alias inpos v0
.alias intex v1
.alias incol v2

.proc main
	mov r0.xyz, inpos
	mov r0.w, ones

	dp4 outpos.x, mvp[0], r0
	dp4 outpos.y, mvp[1], r0
	dp4 outpos.z, mvp[2], r0
	dp4 outpos.w, mvp[3], r0

	mov r2.xy, intex
	mov r2.zw, ones
	dp4 outtc0.x, texmat[0], r2
	dp4 outtc0.y, texmat[1], r2
	mov outtc0.zw, ones

	; The 2D drawer has already turned its colors into R, G, B, A.
	mul r1, colorscale, incol
	mul outcol, colormul, r1

	end
.end
