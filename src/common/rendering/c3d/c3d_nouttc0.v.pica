; c3d_nouttc0.v.pica
; Engine shader minus outtc0 and its two dp4 instructions (test 27, variant V1).
; Same uniforms as the engine shader (8 fvecs), same position transform,
; same color mul, but no texcoord output.
;
; 2026 AlexanderV387 (Nintendo 3DS port). GPL v3 (see LICENSE).

.fvec mvp[4]
.fvec colorscale
.fvec colormul
.fvec texmat[2]

.constf ones(1.0, 1.0, 1.0, 1.0)

.out outpos position
.out outcol color

.alias inpos v0
.alias incol v2

.proc main
	mov r0.xyz, inpos
	mov r0.w,   ones

	dp4 outpos.x, mvp[0], r0
	dp4 outpos.y, mvp[1], r0
	dp4 outpos.z, mvp[2], r0
	dp4 outpos.w, mvp[3], r0

	mul r1, colorscale, incol
	mul outcol, colormul, r1

	end
.end
