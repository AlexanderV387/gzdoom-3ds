; c3d_v0.v.pica
; Test 29 variant V0: dp4 with intex direct (no r2 intermediate), NO outtc0.zw write.
; Isolates whether the dp4 source register (r2 vs intex) is the cause of the GPU hang.
; Same uniforms as c3d_main.v.pica: mvp, colorscale, colormul, texmat.
;
; 2026 AlexanderV387 (Nintendo 3DS port). GPL v3 (see LICENSE).

.fvec mvp[4]
.fvec colorscale	; multiplies the color: 1/255 for bytes, 1 for floats
.fvec colormul		; the render state's light/vertex color for buffers with colors
.fvec texmat[2]		; texture matrix rows (s, t), identity when unused

.constf ones(1.0, 1.0, 1.0, 1.0)

.out outpos position
.out outtc0 texcoord0
.out outcol color

.alias inpos v0
.alias intex v1
.alias incol v2

.proc main
	mov r0.xyz, inpos
	mov r0.w, ones

	dp4 outpos.x, mvp[0], r0
	dp4 outpos.y, mvp[1], r0
	dp4 outpos.z, mvp[2], r0
	dp4 outpos.w, mvp[3], r0

	; TEST 29 V0: dp4 with intex direct (no r2 intermediate). No outtc0.zw.
	dp4 outtc0.x, texmat[0], intex
	dp4 outtc0.y, texmat[1], intex

	; The 2D drawer has already turned its colors into R, G, B, A.
	mul r1, colorscale, incol
	mul outcol, colormul, r1

	end
.end
